rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Categories
    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidCategory(incoming());
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // Menu Items
    function isValidMenuItem(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.categoryId is string &&
             data.isActive is bool;
    }
    match /menu_items/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidMenuItem(incoming());
      allow update: if (isAdmin() && isValidMenuItem(incoming())) ||
                    (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['stock'])); // Allow stock decrement for orders? Usually better via admin or controlled.
      allow delete: if isAdmin();
    }

    // Orders
    function isValidOrder(data) {
      return data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.finalTotal is number && data.finalTotal >= 0 &&
             data.status in ['pending', 'paid', 'cancelled', 'completed'] &&
             data.queueNumber is number && data.queueNumber > 0 &&
             data.createdAt is timestamp;
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/orders/$(orderId)) && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
      allow create: if isValidOrder(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
      allow list: if isAdmin();
    }

    // Promo Codes
    function isValidPromo(data) {
      return data.code is string && data.code.size() > 0 &&
             data.type in ['percent', 'fixed'] &&
             data.value is number && data.value > 0 &&
             data.isActive is bool;
    }
    match /promo_codes/{codeId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPromo(incoming());
      allow update: if isAdmin() && isValidPromo(incoming());
      allow delete: if isAdmin();
    }

    // Queue Settings
    match /settings/queue {
      allow read: if true;
      allow update: if (isSignedIn() || true) && incoming().diff(existing()).affectedKeys().hasOnly(['currentNumber', 'lastResetDate']);
      allow create, delete: if isAdmin();
    }

    // Admin access
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
